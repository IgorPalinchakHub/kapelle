        <mxCell id="present" value="Present implemented flow, coverage, exact results/source, remaining risks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="790" y="810" width="270" height="80" as="geometry" />
