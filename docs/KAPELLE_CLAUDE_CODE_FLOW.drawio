        <mxCell id="classes" value="Claim classes&#xa;observed • inferred • declared • unknown&#xa;stable RC-NNN ids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
