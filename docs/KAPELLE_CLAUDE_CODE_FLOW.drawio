    <diagram id="p6-artifacts" name="06 — Artifacts, scripts &amp; state">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="06 — Artifacts, deterministic writers and state recovery" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Human documents are durable state. Everything under _kapelle/ is derived and rebuildable — but evidence is never fabricated during a rebuild." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#5E6C84;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1500" height="22" as="geometry" />
        </mxCell>
        <mxCell id="tree" value="docs/features/&lt;i&gt;&amp;lt;slug&amp;gt;&lt;/i&gt;/" style="swimlane;html=1;startSize=34;fillColor=#FFFDF7;strokeColor=#D79B00;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="620" height="640" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;STATUS.md&lt;/b&gt; — generated human entry point (never hand-edited)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="580" height="34" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;spec.md&lt;/b&gt; — problem/intent · current behaviour · committed behaviour · use-case map · rules &amp; invariants · candidate capabilities · exclusions &amp; open decisions" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="60" y="182" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;design.md&lt;/b&gt; — context &amp; constraints · boundaries &amp; responsibilities · end-to-end flow · domain &amp; data · contracts &amp; integrations · decisions/risks/deferrals · current walking skeleton" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="60" y="242" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;tasks.md&lt;/b&gt; — implemented base + the ONE active approved slice (nothing else)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="60" y="302" width="580" height="34" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;specs/&lt;/b&gt;&lt;i&gt;&amp;lt;use-case&amp;gt;&lt;/i&gt;&lt;b&gt;.md&lt;/b&gt; — only when a promoted use case has alternatives, authorization, meaningful failures, subprocess reactions, or too many rules to review inline" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="344" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;design/domain-model.md&lt;/b&gt; — on aggregate / lifecycle / money or authorization invariant / event / ownership / non-trivial relationship change" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="404" width="580" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="&lt;b&gt;contracts/&lt;/b&gt; (public API/command/event/external boundary) · focused &lt;b&gt;design/*.md&lt;/b&gt; (3+ interacting components or async flow) · &lt;b&gt;ADR&lt;/b&gt; (expensive-to-reverse choice)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="458" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f8" value="&lt;b&gt;_context/&lt;/b&gt; — feature-local architecture overlay + evidence index&lt;br&gt;&lt;i&gt;worktree drift is recorded here and NEVER rewrites docs/architecture-map.md&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="60" y="518" width="580" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f9" value="&lt;b&gt;_kapelle/&lt;/b&gt; — derived execution state, approvals, rules evidence, verification&lt;br&gt;workflow.json · state.json · manifest.json · architecture-guidance/ · reviews/ · validation/ · verification.json · changes/ (optional) · history/" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="572" width="580" height="56" as="geometry" />
        </mxCell>
        <mxCell id="f10" value="&lt;b&gt;Soft size ceilings&lt;/b&gt; — spec.md ≈250 (&lt;320) · design.md ≈180 (&lt;240) · tasks.md ≈120 lines&lt;br&gt;Split genuinely independent behaviour into specs/, not into more root documents." style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=10;align=left;spacingLeft=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="580" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wr" value="Who may write what" style="swimlane;html=1;startSize=34;fillColor=#FEF6F6;strokeColor=#B85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="690" y="95" width="970" height="330" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="&lt;b&gt;Deterministic Kapelle scripts ONLY&lt;/b&gt;&lt;br&gt;review-gate JSON · _kapelle/manifest.json · _kapelle/state.json · STATUS.md · verification.json&lt;br&gt;&lt;i&gt;Skills and subagents never hand-maintain these files.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="140" width="930" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;Main agent (skills)&lt;/b&gt;&lt;br&gt;spec.md · design.md · tasks.md · specs/ · design/ · contracts/ · ADRs · _context/ · production code · tests" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="710" y="220" width="930" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="&lt;b&gt;Subagents&lt;/b&gt; — return concise evidence only. They never write the human package." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="710" y="290" width="930" height="46" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="&lt;b&gt;Fail-closed schema validation&lt;/b&gt; — every machine JSON/JSONL passes jsonschema_lite via validate_json.py &lt;u&gt;before&lt;/u&gt; it can affect routing or stage completion. Stage validators then add semantic, cross-file, graph, filesystem, freshness and readiness checks." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="710" y="346" width="930" height="62" as="geometry" />
        </mxCell>
        <mxCell id="sc" value="scripts/ — the deterministic layer" style="swimlane;html=1;startSize=34;fillColor=#FEF6F6;strokeColor=#B85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="690" y="445" width="970" height="470" as="geometry" />
        </mxCell>
        <mxCell id="sc1" value="&lt;b&gt;review_gate.py&lt;/b&gt; &lt;i&gt;approve|check&lt;/i&gt; — the ONLY writer of gate JSON; derives filename + exact artifact set" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="490" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc2" value="&lt;b&gt;validate_json.py&lt;/b&gt; — generic fail-closed validator against dispatcher/*.schema.json (backed by jsonschema_lite.py)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="530" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc3" value="&lt;b&gt;validate_progressive_docs.py&lt;/b&gt; — markers, headings, order, non-empty sections, detail-file shape, size caps" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="570" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc4" value="&lt;b&gt;build_feature_status.py&lt;/b&gt; — regenerates STATUS.md&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;validate_feature_state.py&lt;/b&gt; — semantic state check" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="610" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc5" value="&lt;b&gt;rebuild_feature_state.py&lt;/b&gt; — recovery from human docs + code (never fabricates approvals or PASS)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="650" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc6" value="&lt;b&gt;record_verification.py&lt;/b&gt; — the ONLY writer of verification.json; fingerprints inputs + implementation files" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="690" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc7" value="&lt;b&gt;artifact_fingerprint.py&lt;/b&gt; · &lt;b&gt;feature_state.py&lt;/b&gt; — staleness detection primitives shared by the writers" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="730" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc8" value="&lt;b&gt;migrate_workflow.py&lt;/b&gt; (legacy feature → lightweight) · &lt;b&gt;migrate_feature_layout.py&lt;/b&gt; · &lt;b&gt;validate_plugin.py&lt;/b&gt; (plugin self-check)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="770" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc9" value="&lt;b&gt;validate_design.py&lt;/b&gt; · &lt;b&gt;validate_task_plan.py&lt;/b&gt; · &lt;b&gt;validate_architecture_package.py&lt;/b&gt; — used by reconstruction / legacy packages" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="810" width="930" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sc10" value="&lt;b&gt;Invocation shape (Claude Code):&lt;/b&gt;&amp;nbsp; python3 &quot;${CLAUDE_PLUGIN_ROOT}/scripts/&lt;i&gt;x&lt;/i&gt;.py&quot; &quot;${CLAUDE_PROJECT_DIR}/&lt;i&gt;path&lt;/i&gt;&quot; …&lt;br&gt;placeholders are substituted by the harness before the model sees them — one command per tool call, so Bash(python3:*) can be granted narrowly" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="710" y="850" width="930" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rec" value="Recovery path when _kapelle/ is missing or invalid" style="swimlane;html=1;startSize=34;fillColor=#FFFBEF;strokeColor=#D6B656;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="620" height="410" as="geometry" />
        </mxCell>
        <mxCell id="rc1" value="/kapelle:status &lt;i&gt;slug&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="200" y="805" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rc2" value="feature dir exists?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="230" y="865" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rc3" value="rebuild_feature_state.py → validate_feature_state.py&lt;br&gt;&lt;i&gt;checked work is inferred as &lt;b&gt;implemented-unverified&lt;/b&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="130" y="945" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="rc4" value="&lt;b&gt;Route to the EARLIEST necessary command&lt;/b&gt;&lt;br&gt;no valid progressive format → start --revise&lt;br&gt;missing package/guidance or stale plan → start&lt;br&gt;approved slice with unchecked work → implement&lt;br&gt;implemented, no PASS → amend  |  verify&lt;br&gt;PASS without final → verify --approve&lt;br&gt;final approval → completed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="130" y="1020" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rcx" value="Status: REFUSED-missing-input" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="490" y="870" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="er1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="rc1" target="rc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;" edge="1" parent="1" source="rc2" target="rcx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="rc2" target="rc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="rc3" target="rc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="recnote" value="/kapelle:status performs no implementation edits, no validation commands, no git actions and no silent migration." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#5E6C84;" vertex="1" parent="1">
          <mxGeometry x="130" y="1145" width="520" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gnote" value="&lt;b&gt;Coordination graphs&lt;/b&gt; (surface-plan.json, task-plan.json, execution telemetry) are created only when they add real safety for genuine parallel ownership, shared contracts, migrations or complex dependencies — they are &lt;u&gt;not&lt;/u&gt; routine stage outputs." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="690" y="940" width="970" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gnote2" value="&lt;b&gt;docs/architecture-map.md&lt;/b&gt; is a shared repository baseline produced by /kapelle:survey without a slug. Feature work never rewrites it; branch/worktree drift lives in the feature&#39;s _context/ overlay." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="690" y="1030" width="970" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram id="components" name="07 — Component responsibility map">
    <mxGraphModel dx="1700" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Who does what — Claude Code native harness, Kapelle, and the project" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="native" value="CLAUDE CODE NATIVE HARNESS" style="swimlane;html=1;startSize=42;fillColor=#EAF2F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="510" height="950" as="geometry" />
        </mxCell>
        <mxCell id="kapelle" value="KAPELLE PLUGIN" style="swimlane;html=1;startSize=42;fillColor=#F3E5F5;strokeColor=#9673A6;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="595" y="90" width="510" height="950" as="geometry" />
        </mxCell>
        <mxCell id="project" value="PROJECT-NATIVE LAYER" style="swimlane;html=1;startSize=42;fillColor=#E2F0D9;strokeColor=#82B366;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1150" y="90" width="510" height="950" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Skill loader / slash command&#xa;Loads only the invoked SKILL.md and referenced guidance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="160" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Main agent&#xa;Default coordinator, planner, implementer, first reviewer, package author, integration owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="270" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Read / Glob / Search&#xa;Current-worktree evidence; no Git history inspection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="90" y="390" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Bash tool + permission boundary&#xa;One direct Python helper or allowlisted native CLI per call; no shell composition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Developer interaction&#xa;Standalone question, exact validation batch, explicit approval; silence is never approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="90" y="620" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Task/subagents&#xa;Optional bounded roles for uncertainty or risk; concise evidence returns; no raw chatter to developer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="90" y="740" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Agent Teams&#xa;Optional ≤3-agent implementation burst after approval and safe file partitioning; never first skeleton" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="90" y="865" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="Executable skills&#xa;start • implement • amend • verify • status&#xa;+ optional utilities + reconstruct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="150" width="410" height="95" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="Workflow references&#xa;progressive artifacts • orchestration • architecture guidance • human control • script execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="645" y="280" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="Bundled optional roles&#xa;explorer • critic • reviewer • business analyst • devil&#39;s advocate • planner • implementer • test author • reconciler" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="645" y="405" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k4" value="Deterministic writers&#xa;review_gate.py • record_verification.py • build/rebuild feature status&#xa;Only these write gate JSON, manifest, state, STATUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="540" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k5" value="Fail-closed validators + schemas&#xa;validate_json • progressive docs • feature state&#xa;Structural failure blocks routing/completion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="675" width="410" height="95" as="geometry" />
        </mxCell>
        <mxCell id="k6" value="Durable human state&#xa;spec.md • design.md • tasks.md • triggered details&#xa;Derived evidence under _kapelle/" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="805" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k7" value="What Kapelle does not own&#xa;No project rule registry • no mandatory agent chain • no Git • no release automation • no speculative capability implementation" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="645" y="930" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Project source and tests&#xa;Production behavior, configs, schemas, migrations, integration boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="150" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Native instructions and rules&#xa;AGENTS.md / CLAUDE.md / .claude/rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1200" y="275" width="410" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Native project skills and subagents&#xa;.claude/skills • .claude/agents&#xa;selected semantically, never by Kapelle registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="390" width="410" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Architecture-rules capability&#xa;Required for current slice; provider/name/storage are project-defined; returns scoped binding guidance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="520" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Plugins / MCP / read-only CLI&#xa;May supply rules, docs, APIs, or specialized inspection through native discovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1200" y="655" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="Project-native validation commands&#xa;Exact risk-based checks; execution controlled by ask | allow | skip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
