              <mxCell id="recCmds" value="&lt;b&gt;Commands and internal gate names&lt;/b&gt;&lt;br&gt;/kapelle:reconstruct &lt;i&gt;slug&lt;/i&gt; &quot;scope&quot; → gate &lt;b&gt;reconstruction-scope&lt;/b&gt; · --spec → &lt;b&gt;reconstruction-spec&lt;/b&gt; · --design → &lt;b&gt;reconstruction-design&lt;/b&gt; · --review → &lt;b&gt;reconstruction&lt;/b&gt;&lt;br&gt;--approve approves whichever draft STATUS.md currently identifies and never generates the next phase in the same invocation.&lt;br&gt;Marker: &amp;lt;!-- kapelle-workflow: reconstruction-v1 --&amp;gt; in proposal.md + &quot;workflow&quot;: &quot;reconstruction&quot; in _kapelle/workflow.json. Large scope: ≤5 read-only aspect slices, one coordinator owns synthesis.&lt;br&gt;After final approval &lt;b&gt;Run next&lt;/b&gt; is /kapelle:status — never a development stage." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="1520" height="105" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p10-utilities" name="10 — Utilities, migration, deprecated">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ttl" value="10 — Off-backbone routes: utilities, migration, deprecated wrappers" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1300" height="34" as="geometry"/></mxCell>
        <mxCell id="sub" value="None of these is a second pipeline. Every one of them returns to the backbone through /kapelle:status or /kapelle:start --approve." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="22" as="geometry"/></mxCell>

        <mxCell id="uw" value="Optional standalone utilities — run one only when its output is independently useful" style="swimlane;html=1;startSize=34;fillColor=#F6FBF5;strokeColor=#82B366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="800" height="480" as="geometry"/></mxCell>
        <mxCell id="u1" value="&lt;b&gt;/kapelle:survey [slug]&lt;/b&gt;&lt;br&gt;no slug + no baseline → one explorer dispatch → docs/architecture-map.md&lt;br&gt;no slug + baseline exists → Status: BASELINE-READY, &lt;b&gt;no write&lt;/b&gt;&lt;br&gt;with slug → docs/features/&lt;i&gt;slug&lt;/i&gt;/_context/architecture.md only&lt;br&gt;--refresh-baseline needs explicit confirmation and cannot be combined with a slug" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="145" width="740" height="90" as="geometry"/></mxCell>
        <mxCell id="u2" value="&lt;b&gt;/kapelle:decide-adr &lt;i&gt;slug&lt;/i&gt;&lt;/b&gt; — one durable, expensive-to-reverse architectural decision" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="740" height="36" as="geometry"/></mxCell>
        <mxCell id="u3" value="&lt;b&gt;/kapelle:contracts &lt;i&gt;slug&lt;/i&gt;&lt;/b&gt; — human-readable boundary contracts (public API, command, event, external boundary)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="289" width="740" height="36" as="geometry"/></mxCell>
        <mxCell id="u4" value="&lt;b&gt;/kapelle:data-model &lt;i&gt;slug&lt;/i&gt;&lt;/b&gt; — data/schema and domain-model impact" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="333" width="740" height="36" as="geometry"/></mxCell>
        <mxCell id="u5" value="&lt;b&gt;/kapelle:sequences &lt;i&gt;slug&lt;/i&gt;&lt;/b&gt; — one complex runtime flow (3+ interacting components or async)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="377" width="740" height="36" as="geometry"/></mxCell>
        <mxCell id="u6" value="&lt;b&gt;/kapelle:glossary &lt;i&gt;slug&lt;/i&gt;&lt;/b&gt; — disputed domain terms&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;/kapelle:roadmap &lt;i&gt;slug&lt;/i&gt;&lt;/b&gt; — project roadmap placement" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="421" width="740" height="36" as="geometry"/></mxCell>
        <mxCell id="u7" value="&lt;b&gt;Return route:&lt;/b&gt; changed the approved package → &lt;b&gt;/kapelle:start &lt;i&gt;slug&lt;/i&gt; --approve&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;otherwise → &lt;b&gt;/kapelle:status&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="740" height="42" as="geometry"/></mxCell>
        <mxCell id="u8" value="Utilities perform no implementation edits and no git actions. Their contract is references/utility-contract.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="740" height="20" as="geometry"/></mxCell>

        <mxCell id="mw" value="/kapelle:migrate — adopt an older feature directory into the lightweight workflow" style="swimlane;html=1;startSize=34;fillColor=#FFFBEF;strokeColor=#D6B656;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="95" width="790" height="480" as="geometry"/></mxCell>
        <mxCell id="g1" value="&lt;b&gt;dry run (default)&lt;/b&gt;&lt;br&gt;migrate_workflow.py &lt;i&gt;docs/features/slug&lt;/i&gt;&lt;br&gt;reports preserved documents, missing spec/design/tasks,&lt;br&gt;evidence that cannot be reconstructed, and the next command" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="730" height="75" as="geometry"/></mxCell>
        <mxCell id="g2" value="spec.md present?&lt;br&gt;&lt;i&gt;(it carries the durable marker — the only prerequisite)&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1050" y="250" width="430" height="80" as="geometry"/></mxCell>
        <mxCell id="g3" value="&lt;b&gt;--apply&lt;/b&gt; → adds the lightweight marker, writes workflow version 2, rebuilds status&lt;br&gt;preserves proposal.md, detailed specs/designs, contracts, ADRs, task evidence, history" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="730" height="60" as="geometry"/></mxCell>
        <mxCell id="g4" value="→ /kapelle:start &lt;i&gt;slug&lt;/i&gt; &quot;raw task or current feature intent&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="900" y="255" width="130" height="70" as="geometry"/></mxCell>
        <mxCell id="g5" value="&lt;b&gt;Migration never invents history&lt;/b&gt; — no approvals, validation results, agent reviews, command output or telemetry. No production-code, validation or git changes. Handoff is the exact command returned by the helper." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="730" height="70" as="geometry"/></mxCell>
        <mxCell id="eg1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;strokeColor=#B85450;" edge="1" parent="1" source="g2" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="dw" value="Deprecated compatibility wrappers — they never execute their former stage protocol" style="swimlane;html=1;startSize=34;fillColor=#FEF6F6;strokeColor=#B85450;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="1620" height="290" as="geometry"/></mxCell>
        <mxCell id="dp1" value="&lt;b&gt;16 wrapper names&lt;/b&gt;&lt;br&gt;spec · specify · clarify · classify-size · design · plan&lt;br&gt;plan-tests · decompose · base-functional-tests · unit-tests&lt;br&gt;change · resume-change · fix · feature-review · finalize · ship" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="70" y="655" width="470" height="105" as="geometry"/></mxCell>
        <mxCell id="dp2" value="&lt;b&gt;On invocation (references/deprecated-legacy-stages.md)&lt;/b&gt;&lt;br&gt;1. no human-controlled marker ⇒ Status: DEPRECATED + /kapelle:migrate &lt;i&gt;slug&lt;/i&gt;&lt;br&gt;2. otherwise ⇒ Status: DEPRECATED + the replacement command named by the wrapper&lt;br&gt;3. write no feature or project files; run no agent, validation, git or migration action" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="570" y="655" width="580" height="105" as="geometry"/></mxCell>
        <mxCell id="dp3" value="&lt;b&gt;Typical replacements&lt;/b&gt;&lt;br&gt;analysis / design / planning names → &lt;b&gt;/kapelle:start&lt;/b&gt;&lt;br&gt;change · resume-change · fix → &lt;b&gt;/kapelle:amend&lt;/b&gt;&lt;br&gt;test · review · release names → &lt;b&gt;/kapelle:verify&lt;/b&gt;&lt;br&gt;&lt;i&gt;each wrapper names its own exact replacement&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1180" y="655" width="450" height="105" as="geometry"/></mxCell>
        <mxCell id="dp4" value="Wrappers exist for one compatibility release and may then be removed. Kapelle has exactly one human-controlled pipeline: &lt;b&gt;start → implement → (amend →) verify&lt;/b&gt;, with &lt;b&gt;status&lt;/b&gt; as recovery and routing." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="70" y="780" width="1560" height="50" as="geometry"/></mxCell>

        <mxCell id="core" value="&lt;b&gt;Core invariant:&lt;/b&gt; stage → native project capability → guidance/tools/code is one-way. Project skills never invoke Kapelle stages, and project-specific behaviour belongs in native project capabilities, not in core stages." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=12;align=left;spacingLeft=8;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="1620" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
