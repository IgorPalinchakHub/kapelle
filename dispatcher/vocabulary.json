{
  "//": "Canonical Kapelle vocabulary. Single source of truth for states, dispositions, and stage order. Schemas and documents must match it; scripts/validate_plugin.py enforces consistency.",
  "backbone_stages": [
    "start",
    "implement",
    "verify"
  ],
  "change_route_stages": [
    "start",
    "implement",
    "verify",
    "amend"
  ],
  "task_states": [
    "pending",
    "in-progress",
    "blocked",
    "completed",
    "implemented-unverified",
    "validation-deferred",
    "stale",
    "needs-rework",
    "superseded",
    "unknown"
  ],
  "feature_states": [
    "planning",
    "awaiting-human-review",
    "reconstructing",
    "documentation-review",
    "documented",
    "implementation",
    "unit-testing",
    "verifying",
    "completed",
    "validation-deferred",
    "review-ready",
    "ship-ready",
    "recovered",
    "recovered-with-gaps",
    "external-development",
    "externally-implemented-unverified",
    "blocked",
    "shipped"
  ],
  "recovery_task_dispositions": [
    "not-started",
    "implemented-unverified",
    "validated",
    "needs-rework",
    "superseded",
    "unknown"
  ],
  "artifact_states": [
    "current",
    "review-required",
    "stale",
    "superseded"
  ],
  "implementation_plan_states": [
    "draft",
    "approved",
    "stale",
    "superseded"
  ],
  "change_states": [
    "running",
    "paused",
    "reconciling",
    "waiting-approval",
    "approved",
    "resumable",
    "blocked",
    "completed"
  ],
  "change_state_transitions": {
    "running": ["paused", "completed"],
    "paused": ["reconciling"],
    "reconciling": ["waiting-approval"],
    "waiting-approval": ["approved", "blocked"],
    "approved": ["resumable"],
    "resumable": ["running"],
    "blocked": [],
    "completed": []
  },
  "reconciliation_dispositions": [
    "keep",
    "revalidate",
    "rework",
    "supersede",
    "revert-required"
  ],
  "disposition_to_task_state": {
    "keep": "completed",
    "revalidate": "stale",
    "rework": "needs-rework",
    "supersede": "superseded",
    "revert-required": "blocked"
  }
}
