{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapelle.dev/schemas/task-context.schema.json",
  "title": "Kapelle implementation task context",
  "description": "Descriptive context passed to native Claude Code project capabilities. No field selects a skill, agent, provider, or gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "intent",
    "workstream_id",
    "deps",
    "acs",
    "dod",
    "primary_aspect",
    "aspects",
    "provides_contracts",
    "consumes_contracts",
    "integration_checks",
    "validation",
    "risk",
    "parallel_candidate",
    "ownership_status",
    "files_hint",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "workstream_id": { "type": "string", "minLength": 1 },
    "deps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dod": { "type": "string", "minLength": 1 },
    "module_hint": { "type": ["string", "null"] },
    "primary_aspect": { "type": "string", "minLength": 1 },
    "aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "entrypoint_hint": { "type": ["string", "null"] },
    "provides_contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "consumes_contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "integration_checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "procedure", "expected"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["automated", "manual", "inspection"]
          },
          "procedure": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "Omitted means required. Optional checks need explicit false and rationale in the task plan."
          },
          "optional_reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "required": { "const": false } },
              "required": ["required"]
            },
            "then": { "required": ["optional_reason"] }
          }
        ]
      }
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "parallel_candidate": { "type": "boolean" },
    "ownership_status": {
      "type": "string",
      "enum": ["known", "unknown"]
    },
    "files_hint": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in-progress",
        "blocked",
        "completed",
        "implemented-unverified",
        "validation-deferred",
        "stale",
        "needs-rework",
        "superseded",
        "unknown"
      ]
    }
  }
}
