{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapelle.dev/schemas/decomposition-review.schema.json",
  "title": "Kapelle task decomposition review",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUESTED", "BLOCKED"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "task_or_workstream", "issue", "required_change"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "warning"]
          },
          "task_or_workstream": { "type": "string", "minLength": 1 },
          "issue": { "type": "string", "minLength": 1 },
          "required_change": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
