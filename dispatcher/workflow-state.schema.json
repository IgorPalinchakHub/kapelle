{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapelle.dev/schemas/workflow-state.schema.json",
  "title": "Kapelle workflow marker",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "version",
        "created_from",
        "profile"
      ],
      "properties": {
        "workflow": {
          "const": "human-controlled"
        },
        "version": {
          "const": 2
        },
        "created_from": {
          "const": "raw-task"
        },
        "profile": {
          "const": "lightweight"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "version",
        "created_from"
      ],
      "properties": {
        "workflow": {
          "const": "reconstruction"
        },
        "version": {
          "const": 1
        },
        "created_from": {
          "const": "existing-code"
        }
      }
    }
  ]
}
