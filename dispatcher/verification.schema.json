{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapelle.dev/schemas/verification.schema.json",
  "title": "Kapelle complete feature verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "categories", "commands", "input_fingerprints", "implementation_fingerprints"],
  "properties": {
    "status": { "type": "string", "enum": ["PASS", "FAILED", "validation-deferred"] },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["functional", "unit", "integration", "contract", "static-analysis", "lint", "build"]
      },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_fingerprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "implementation_fingerprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
