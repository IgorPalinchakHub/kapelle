{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapelle.dev/schemas/unit-test-run.schema.json",
  "title": "Kapelle post-implementation unit-test phase",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "planned_units", "test_files", "commands", "input_fingerprints", "implementation_fingerprints"],
  "properties": {
    "status": { "type": "string", "enum": ["PASS", "FAILED", "validation-deferred"] },
    "planned_units": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "test_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "input_fingerprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "implementation_fingerprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
