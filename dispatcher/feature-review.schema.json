{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapelle.dev/schemas/feature-review.schema.json",
  "title": "Kapelle feature-level review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "input_fingerprints",
    "validation_files",
    "reviewed_aspects",
    "findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "CHANGES_REQUESTED", "BLOCKED"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "input_fingerprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "validation_files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "reviewed_aspects": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "PASS" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "findings": { "maxItems": 0 } }
      }
    }
  ]
}
